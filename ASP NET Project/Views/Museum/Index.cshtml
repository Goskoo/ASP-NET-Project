@model IEnumerable<ASP_NET_Project.Data.Models.Museum>

@{
    ViewData["Title"] = "Museums";
}

<h1>Museums</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Add Museum
    </a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>City</th>
            <th>Country</th>
            <th>Minerals</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var museum in Model)
        {
            <tr>
                <td>@museum.Name</td>

                <td>@museum.Description</td>

                <td>@museum.City</td>

                <td>@museum.Country</td>

                <td>
                    @if (museum.Minerals != null && museum.Minerals.Any())
                    {
                        @string.Join(", ", museum.Minerals.Select(m => m.Name))
                    }
                    else
                    {
                        <span>No minerals</span>
                    }
                </td>

                <td>
                    <a asp-controller="Museum"
                       asp-action="Details"
                       asp-route-id="@museum.Id">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
