@model ASP_NET_Project.Data.Models.Museum

@{
    ViewData["Title"] = "Museum Details";
}

<h1>@Model.Name</h1>

<p><strong>Description:</strong> @Model.Description</p>
<p><strong>City:</strong> @Model.City</p>
<p><strong>Country:</strong> @Model.Country</p>

<h2>Minerals</h2>

@if (Model.Minerals != null && Model.Minerals.Any())
{
    <ul>
        @foreach (var mineral in Model.Minerals)
        {
            <li>@mineral.Name</li>
        }
    </ul>
}
else
{
    <p>No minerals associated with this museum.</p>
}

<a asp-action="Index">Back to Museums</a>