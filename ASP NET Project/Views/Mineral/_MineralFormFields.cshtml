@using ASP_NET_Project.Data.Enum
@model ASP_NET_Project.ViewModels.MineralFormViewModel

<div class="row">
    <div class="col-md-9 mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="col-md-3 mb-3">
        <label asp-for="MohsScale" class="form-label"></label>
        <input asp-for="MohsScale" class="form-control" />
        <span asp-validation-for="MohsScale" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Colors" class="form-label"></label>
        <input asp-for="Colors" class="form-control" />
        <span asp-validation-for="Colors" class="text-danger"></span>
    </div>
    
    <div class="col-md-4 mb-3">
        <label asp-for="Luster" class="form-label"></label>
        <input asp-for="Luster" class="form-control" />
        <span asp-validation-for="Luster" class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="Streak" class="form-label"></label>
        <input asp-for="Streak" class="form-control" />
        <span asp-validation-for="Streak" class="text-danger"></span>
    </div>
    
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Category" class="form-label"></label>
        <select asp-for="Category" asp-items="Html.GetEnumSelectList<MineralCategory>()" class="form-select"></select>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="Transparency" class="form-label"></label>
        <select asp-for="Transparency" asp-items="Html.GetEnumSelectList<Transparency>()" class="form-select"></select>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="CrystalSystem" class="form-label"></label>
        <select asp-for="CrystalSystem" asp-items="Html.GetEnumSelectList<CrystalSystem>()" class="form-select"></select>
    </div>
</div>

<div class="row">

    <div class="col-md-4 mb-3">
        <label asp-for="CrystalHabit" class="form-label"></label>
        <input asp-for="CrystalHabit" class="form-control" />
        <span asp-validation-for="CrystalHabit" class="text-danger"></span>
    </div>
    
    <div class="col-md-4 mb-3">
        <label asp-for="Cleavage" class="form-label"></label>
        <input asp-for="Cleavage" class="form-control" />
        <span asp-validation-for="Cleavage" class="text-danger"></span>
    </div>
    
    <div class="col-md-4 mb-3">
        <label asp-for="Fracture" class="form-label"></label>
        <input asp-for="Fracture" class="form-control" />
        <span asp-validation-for="Fracture" class="text-danger"></span>
    </div>

</div>


<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="CollectingTips" class="form-label"></label>
    <textarea asp-for="CollectingTips" class="form-control" rows="3"></textarea>
    <span asp-validation-for="CollectingTips" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="ProcessingTips" class="form-label"></label>
    <textarea asp-for="ProcessingTips" class="form-control" rows="3"></textarea>
    <span asp-validation-for="ProcessingTips" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="SelectedLocationIds" class="form-label">Found in</label>
    <select asp-for="SelectedLocationIds" asp-items="Model.Locations" class="form-select" multiple size="4"></select>
</div>

<div class="mb-3">
    <label asp-for="SelectedMuseumIds" class="form-label">Displayed in</label>
    <select asp-for="SelectedMuseumIds" asp-items="Model.Museums" class="form-select" multiple size="4"></select>
</div>
