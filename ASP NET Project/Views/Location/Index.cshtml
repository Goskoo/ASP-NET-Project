@model IEnumerable<ASP_NET_Project.Data.Models.Location>

@{
    ViewData["Title"] = "Locations";
}

<h1>Locations</h1>

<table class="table table table-striped table-hover">
    <thead>
        <tr>
            <th>Country</th>
            <th>RegionName</th>
            <th>MiningHistoryNotes</th>
            <th>IsActiveMiningSite</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var location in Model)
        {
            <tr>
                 <td>@location.Country</td>
                 <td>@location.RegionName</td>
                 <td>@location.MiningHistoryNotes</td>
                <td>@(location.IsActiveMiningSite ? "Yes" : "No")</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@location.Id">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>