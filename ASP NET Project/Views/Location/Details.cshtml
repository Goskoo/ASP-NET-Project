@model ASP_NET_Project.Data.Models.Location

@{
	ViewData["Title"] = "Location Details";
}

<h1>Location Details</h1>

<div class="card mb-4">
	<div class="card-body">
		<h3>@Model.Country - @Model.RegionName</h3>

			<p> 
				@Model.MiningHistoryNotes
			</p>
			
			<p>
				<span class="fw-bold">
				Active Mining Site:
				</span>
				@(Model.IsActiveMiningSite ? "Yes" : "No")
			</p>
	</div>

</div>

<h2>Minerals Found In This Location</h2>

<div class="table-responsive">
	<table class="table table-striped table-hover">
	<thead>
		<tr>
			<th>Name</th>
			<th>Category</th>
			<th>Colors</th>
			<th></th>
		</tr>
	</thead>

	<tbody>
		@foreach (var mineral in Model.Minerals)
			{
				<tr>
					<td>@mineral.Name</td>
					<td>@mineral.Category</td>
					<td>@mineral.Colors</td>
					<td>
						<a asp-controller="Mineral"
						asp-action="Details"
						asp-route-id="@mineral.Id">
						Details
					</a>
					</td>
				</tr>
			}
	</tbody>
	</table>
</div>

	<a asp-action="Index">Back To Locations</a>